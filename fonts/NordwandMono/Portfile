worksrcdir          .

checksums           rmd160  1f8d50253ac15e11beeb15c1c785bea7e3675f42 \
                    sha256  0f82e5b1161add4c975af6c7d8e5a82f40c173b0098de8f7bfe5d9486cc40fd5 \
                    size    607316

build {}

destroot.violate_mtree yes

